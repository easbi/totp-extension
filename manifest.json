{
  "manifest_version": 3,
  "name": "TOTP Authenticator",
  "version": "1.0",
  "description": "Browser extension TOTP-Easbi dengan fitur import export dan proteksi PIN.",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "icons": {
    "48": "icon48.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "48": "icon48.png"
    }
  }
}